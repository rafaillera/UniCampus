<?xml version="1.0"?>
<!--
  Configuración de UniCampus.Web.
  La cadena de conexión usa Autenticación de Windows (Integrated Security):
  no contiene usuarios ni contraseñas. Ajuste "Data Source" a su instancia
  local de SQL Server si no se llama .\SQLEXPRESS (por ejemplo "." o
  "(localdb)\MSSQLLocalDB"). No suba a GitHub su cambio local de instancia.
-->
<configuration>
  <connectionStrings>
    <add name="UniCampusDb" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=UniCampusDB;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" enableVersionHeader="false"/>
    <globalization culture="es-CO" uiCulture="es-CO" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8"/>
    <!-- Sesión en memoria del servidor, solo por cookie y con expiración de 30 minutos. -->
    <sessionState mode="InProc" cookieless="UseCookies" timeout="30"/>
    <!-- Las cookies no se pueden leer desde JavaScript (mitiga robo de sesión por XSS). -->
    <httpCookies httpOnlyCookies="true"/>
    <!-- Los usuarios remotos ven una página genérica; el detalle técnico solo se ve en local. -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.html"/>
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Login.aspx"/>
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
